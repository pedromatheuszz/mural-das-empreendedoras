{
  "expo": {
    "name": "Mural das Empreendedoras",
    "slug": "hub-empreendedoras",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hubempreendedoras",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF8F5",
    "primaryColor": "#6B1D3A",
    "description": "Mural de empreendedorismo feminino: crie o perfil do seu negócio, divulgue seus serviços e seja descoberta por novas clientes e parceiras.",
    "ios": {
      "bundleIdentifier": "br.com.hubempreendedoras.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "br.com.hubempreendedoras.app",
      "adaptiveIcon": {
        "backgroundColor": "#6B1D3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Mural das Empreendedoras",
      "themeColor": "#6B1D3A",
      "backgroundColor": "#FBF8F5"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6B1D3A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Mural das Empreendedoras usa suas fotos para que você escolha o logotipo e a foto do seu perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "new-tech-tecnologia",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bd8ff9cc-8be3-4b43-9f51-7da46369690d"
      }
    }
  }
}
