# =============================================================================
# Hub de Empreendedoras — variáveis de ambiente
# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase.
# O arquivo .env não vai para o repositório (.gitignore).
# =============================================================================

# Supabase → Project Settings → Data API → Project URL


NEON_DATABASE_URL=postgresql://USUARIO:SENHA@SEU-HOST.neon.tech/neondb?sslmode=require

NEON_API_KEY=cole-aqui-sua-chave-da-api-neon
NEON_PROJECT_ID=seu-projeto-123456
NEON_BRANCH_ID=br-sua-branch-123456

# Supabase → Project Settings → API Keys → chave PÚBLICA:
#   "Publishable key" (sb_publishable_...) ou a "anon key" (legada).
# NUNCA use a "secret key" (sb_secret_...) nem a "service_role" aqui: elas ignoram
# as regras de segurança (RLS) e ficariam expostas dentro do aplicativo.


# Contatos exibidos no app e nos textos legais (opcional; há valores de exemplo).
EXPO_PUBLIC_SUPPORT_EMAIL=contato@seudominio.com.br
EXPO_PUBLIC_PRIVACY_EMAIL=privacidade@seudominio.com.br

# Login de desenvolvedor (OPCIONAL, só em desenvolvimento): mostra o botão
# "Login de desenvolvedor" na tela de login. Use a conta que recebeu o papel admin
# (veja docs/SUPABASE.md → "Login de desenvolvedor"). Nunca cadastre no EAS de produção.
EXPO_PUBLIC_DEV_LOGIN_EMAIL=
EXPO_PUBLIC_DEV_LOGIN_PASSWORD=

# App (públicos): Neon Console → Auth e Data API
EXPO_PUBLIC_NEON_AUTH_URL=https://SEU-ENDPOINT.neonauth.REGIAO.aws.neon.tech/neondb/auth
EXPO_PUBLIC_NEON_DATA_API_URL=https://SEU-ENDPOINT.apirest.REGIAO.aws.neon.tech/neondb/rest/v1
# Origem confiável do Neon Auth (produção: um domínio https cadastrado em Auth → Domains)
EXPO_PUBLIC_NEON_AUTH_ORIGIN=http://localhost
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Gestão de cargos pela API (npm run role): conta com cargo de desenvolvedor. Só scripts, nunca o app.
ROLE_ADMIN_EMAIL=
ROLE_ADMIN_PASSWORD=
